# === Plantilla de variables de entorno ===
# Copia este archivo como .env  (el .env real está ignorado por git y NO se sube).
#   PowerShell:  Copy-Item .env.example .env
#
# NUNCA subas el .env con la contraseña real a GitHub.
# En producción, estos valores se ponen en Render → Environment, no en el repo.

# --- Base de datos ---
# LOCAL (rápido, sin instalar nada):
DATABASE_URL=sqlite:///./ayni.db
#
# SUPABASE (producción): copia la URI del pooler desde
#   Supabase → Project Settings → Database → Connection string → URI
# y reemplaza [YOUR-PASSWORD] por tu contraseña. Ejemplo:
# DATABASE_URL=postgresql://postgres.abcd1234:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Seguridad ---
JWT_SECRET=dev-secret-change-me

# --- CORS (orígenes permitidos; "*" o lista separada por comas) ---
CORS_ORIGINS=*

# --- Sembrar datos de demo al iniciar (true/false) ---
SEED_ON_STARTUP=true
