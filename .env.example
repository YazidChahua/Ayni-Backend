# === Plantilla de variables de entorno ===
# Copia este archivo como .env  (el .env real está ignorado por git y NO se sube).
#   PowerShell:  Copy-Item .env.example .env
#
# NUNCA subas el .env con la contraseña real a GitHub.
# En producción, estos valores se ponen en Render → Environment, no en el repo.

# --- Base de datos ---
# LOCAL (rápido, sin instalar nada):
DATABASE_URL=sqlite:///./ayni.db
#
# SUPABASE (producción): copia la URI del pooler desde
#   Supabase → Project Settings → Database → Connection string → URI
# y reemplaza [YOUR-PASSWORD] por tu contraseña. Ejemplo:
# DATABASE_URL=postgresql://postgres.abcd1234:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Seguridad ---
JWT_SECRET=dev-secret-change-me

# --- CORS (orígenes permitidos; "*" o lista separada por comas) ---
CORS_ORIGINS=*

# --- Sembrar datos de demo al iniciar (true/false) ---
SEED_ON_STARTUP=true

# --- RENIEC (consulta de DNI para el registro) ---
# Sin token funciona en modo demo (datos de prueba). Para datos reales, obtén un
# token de un proveedor (apis.net.pe, apiperu.dev, decolecta) y pégalo aquí.
RENIEC_API_URL=https://api.apis.net.pe/v2/reniec/dni
RENIEC_API_TOKEN=

# --- Verificación por correo (código OTP) ---
# Sin proveedor, el código se devuelve en la respuesta para probar (modo demo).
OTP_DEV_RETURN_CODE=true

# Resend (recomendado). El token va en Render → Environment (NO en el repo).
# "from" debe ser un dominio verificado en Resend; para pruebas: Ayni <onboarding@resend.dev>
RESEND_API_TOKEN=
RESEND_FROM=Ayni <onboarding@resend.dev>

# SMTP (alternativa a Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ayni <no-reply@ayni.pe>
